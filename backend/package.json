{
  "name": "wechat-text-adventure-backend",
  "version": "0.1.0",
  "description": "Fastify + TypeScript backend for the WeChat text adventure mini program",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest --config tests/contract/jest.config.ts --runInBand --detectOpenHandles --forceExit"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "fastify": "^4.26.2",
    "fastify-plugin": "^4.0.0",
    "cos-nodejs-sdk-v5": "^2.13.1",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^18.18.0",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "ajv": "^8.12.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
