.list-container {
  padding: 24rpx;
  padding-bottom: calc(env(safe-area-inset-bottom, 0) + 140rpx);
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  min-height: 100vh;
}

.recommend-section {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, 0.06);
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.recommend-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.recommend-header-text {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.recommend-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1c1c1e;
}

.recommend-subtitle {
  font-size: 24rpx;
  color: #8e8e93;
}

.recommend-refresh {
  border-radius: 999rpx;
  padding: 8rpx 28rpx;
  font-size: 26rpx;
  border: 2rpx solid rgba(10, 132, 255, 0.3);
  color: #0a84ff;
}

.recommend-scroll {
  display: flex;
  gap: 16rpx;
}

.recommend-card {
  min-width: 420rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: linear-gradient(180deg, #f5f9ff 0%, #ffffff 100%);
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  box-shadow: 0 12rpx 28rpx rgba(12, 68, 204, 0.08);
}

.recommend-card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.recommend-reason {
  font-size: 24rpx;
  color: #0a84ff;
  background: rgba(10, 132, 255, 0.12);
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}

.recommend-order {
  font-size: 22rpx;
  color: #8e8e93;
}

.recommend-card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1c1c1e;
}

.recommend-card-desc {
  font-size: 26rpx;
  color: #636366;
  line-height: 38rpx;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.recommend-card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
  color: #8e8e93;
}

.recommend-card-action {
  color: #0a84ff;
  font-weight: 600;
}

.recommend-empty {
  font-size: 26rpx;
  color: #8e8e93;
}

.search-bar {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.search-input {
  flex: 1;
  padding: 20rpx;
  border-radius: 20rpx;
  background: rgba(142, 142, 147, 0.12);
  color: #1c1c1e;
}

.clear-button {
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  background: rgba(142, 142, 147, 0.2);
  color: #1c1c1e;
}

.loading {
  text-align: center;
  color: #636366;
}

.theme-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.theme-item {
  position: relative;
  display: flex;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 24rpx rgba(0, 0, 0, 0.06);
}

.theme-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.title {
  font-size: 34rpx;
  color: #1c1c1e;
  font-weight: 600;
}

.description {
  font-size: 28rpx;
  color: #636366;
}

.tags {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.tag {
  padding: 8rpx 16rpx;
  background: rgba(10, 132, 255, 0.12);
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #0a84ff;
}

.favorite-button {
  width: 80rpx;
  height: 80rpx;
  font-size: 44rpx;
  color: #ff9f0a;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
}

.list-container.night-mode {
  background: #1c1c1e;
  color: #f2f2f7;
}

.list-container.night-mode .recommend-section {
  background: #2c2c2e;
  box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, 0.4);
}

.list-container.night-mode .recommend-title {
  color: #f5f5f7;
}

.list-container.night-mode .recommend-subtitle,
.list-container.night-mode .recommend-order,
.list-container.night-mode .recommend-card-footer,
.list-container.night-mode .recommend-empty {
  color: #aeaeb2;
}

.list-container.night-mode .recommend-refresh {
  border-color: rgba(10, 132, 255, 0.5);
  color: #82b6ff;
}

.list-container.night-mode .recommend-card {
  background: linear-gradient(180deg, #2c2c2e 0%, #1c1c1e 100%);
  box-shadow: 0 12rpx 28rpx rgba(0, 0, 0, 0.55);
}

.list-container.night-mode .recommend-reason {
  background: rgba(10, 132, 255, 0.18);
  color: #82b6ff;
}

.list-container.night-mode .recommend-card-title {
  color: #f5f5f7;
}

.list-container.night-mode .recommend-card-desc {
  color: #d1d1d6;
}

.list-container.night-mode .recommend-card-action {
  color: #82b6ff;
}

.list-container.night-mode .search-input {
  background: rgba(118, 118, 128, 0.24);
  color: #f5f5f7;
}

.list-container.night-mode .clear-button {
  background: rgba(118, 118, 128, 0.32);
  color: #f5f5f7;
}

.list-container.night-mode .theme-item {
  background: #2c2c2e;
  box-shadow: 0 12rpx 24rpx rgba(0, 0, 0, 0.45);
}

.list-container.night-mode .title {
  color: #f5f5f7;
}

.list-container.night-mode .description {
  color: #d1d1d6;
}

.list-container.night-mode .tag {
  background: rgba(10, 132, 255, 0.2);
  color: #82b6ff;
}

.list-container.night-mode .loading {
  color: #aeaeb2;
}
