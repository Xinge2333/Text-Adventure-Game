.my-container {
  padding: 32rpx 24rpx calc(env(safe-area-inset-bottom, 0) + 128rpx);
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  min-height: 100vh;
}

.section-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  gap: 24rpx;
  position: relative;
}

.profile-card {
  align-items: flex-start;
  overflow: hidden;
}

.profile-card-logged {
  background: linear-gradient(135deg, #0a84ff, #3dd5f3);
  color: #ffffff;
}

.profile-card-logged .profile-name,
.profile-card-logged .profile-subtitle {
  color: #ffffff;
}

.profile-card-logged .card-arrow {
  color: rgba(255, 255, 255, 0.7);
}

.profile-card-anon {
  background: linear-gradient(135deg, #ffffff, #f8f9fb);
}

.profile-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #f2f2f7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.profile-avatar-image {
  border: 4rpx solid rgba(255, 255, 255, 0.6);
}

.profile-avatar.large {
  width: 144rpx;
  height: 144rpx;
  font-size: 64rpx;
}

.profile-text {
  flex: 1;
}

.profile-name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #1c1c1e;
}

.profile-subtitle {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #636366;
}

.profile-badge {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.25);
  color: #ffffff;
}

.profile-stats {
  margin-top: 20rpx;
  display: flex;
  gap: 32rpx;
}

.profile-stat-value {
  font-size: 34rpx;
  font-weight: 600;
}

.profile-stat-label {
  font-size: 24rpx;
  color: rgba(28, 28, 30, 0.6);
}

.profile-card-logged .profile-stat-label {
  color: rgba(255, 255, 255, 0.7);
}

.profile-inline-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  position: absolute;
  right: 96rpx;
  top: 50%;
  transform: translateY(-50%);
  align-items: flex-end;
}

.profile-inline-btn {
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
  color: #ffffff;
  font-size: 26rpx;
  padding: 8rpx 32rpx;
  border: none;
}

.profile-inline-btn.outline {
  background: transparent;
  border: 2rpx solid rgba(255, 255, 255, 0.6);
}

.card-arrow {
  color: #b0b0b8;
  font-size: 44rpx;
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  pointer-events: none;
}

.favorites-card,
.settings-card {
  padding-right: 96rpx;
}

.profile-card {
  padding-right: 156rpx;
}

.card-header {
  flex: 1;
}

.card-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1c1c1e;
}

.card-subtitle {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #636366;
}

.card-preview {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.preview-item {
  font-size: 28rpx;
  color: #1c1c1e;
  background: #f5f5f7;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
}

.preview-more,
.preview-empty {
  font-size: 26rpx;
  color: #8e8e93;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  padding: 40rpx;
}

.modal-content {
  width: 100%;
  max-width: 640rpx;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 40rpx 32rpx 32rpx;
  box-shadow: 0 20rpx 40rpx rgba(0, 0, 0, 0.15);
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.modal-content.wide {
  max-width: 720rpx;
  height: 70vh;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1c1c1e;
  text-align: center;
}

.modal-body {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.modal-close {
  border-radius: 999rpx;
  background: linear-gradient(135deg, #0a84ff, #5ac8fa);
  color: #ffffff;
  font-size: 30rpx;
}

.logout-button {
  border-radius: 999rpx;
  border: 2rpx solid #ff3b30;
  color: #ff3b30;
  background: transparent;
  margin-top: 8rpx;
}

.profile-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.profile-details {
  display: flex;
  flex-direction: column;
}

.profile-tip {
  font-size: 26rpx;
  color: #8e8e93;
  text-align: center;
}

.profile-actions {
  display: flex;
  justify-content: center;
  margin-top: -8rpx;
}

.login-button {
  border-radius: 999rpx;
  background: linear-gradient(135deg, #0a84ff, #5ac8fa);
  color: #ffffff;
  font-size: 30rpx;
  padding: 12rpx 48rpx;
}

.favorites-list {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.modal-favorite-item {
  background: #f8f8fa;
  border-radius: 20rpx;
  padding: 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 16rpx;
}

.favorite-text-group {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.favorite-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1c1c1e;
}

.favorite-description {
  font-size: 26rpx;
  color: #636366;
}

.favorite-star {
  font-size: 44rpx;
  color: #ff9f0a;
  width: 64rpx;
  text-align: center;
}

.settings-item {
  background: #f8f8fa;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24rpx;
}

.settings-item.column {
  flex-direction: column;
  align-items: flex-start;
  gap: 24rpx;
}

.settings-text {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.settings-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1c1c1e;
}

.settings-subtitle {
  font-size: 24rpx;
  color: #8e8e93;
}

.model-options {
  display: flex;
  gap: 32rpx;
}

.model-option {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  color: #1c1c1e;
}

.my-container.night-mode {
  background: #1c1c1e;
  color: #f5f5f7;
}

.my-container.night-mode .section-card {
  background: #2c2c2e;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.45);
  color: #f5f5f7;
}

.my-container.night-mode .card-title,
.my-container.night-mode .profile-name,
.my-container.night-mode .favorite-title,
.my-container.night-mode .settings-title {
  color: #f5f5f7;
}

.my-container.night-mode .card-subtitle,
.my-container.night-mode .profile-subtitle,
.my-container.night-mode .preview-empty,
.my-container.night-mode .preview-more,
.my-container.night-mode .profile-tip,
.my-container.night-mode .settings-subtitle,
.my-container.night-mode .model-option,
.my-container.night-mode .favorite-description,
.my-container.night-mode .profile-stat-label {
  color: #d1d1d6;
}

.my-container.night-mode .preview-item {
  background: rgba(118, 118, 128, 0.32);
  color: #f5f5f7;
}

.my-container.night-mode .favorites-card,
.my-container.night-mode .settings-card {
  background: #2c2c2e;
}

.my-container.night-mode .card-arrow {
  color: rgba(235, 235, 245, 0.6);
}

.my-container.night-mode .favorites-card .card-subtitle {
  color: #aeaeb2;
}

.my-container.night-mode .settings-item {
  background: rgba(58, 58, 60, 0.8);
}

.my-container.night-mode .modal-content,
.modal-content.night-mode {
  background: #2c2c2e;
  color: #f5f5f7;
  box-shadow: 0 20rpx 40rpx rgba(0, 0, 0, 0.55);
}

.modal-content.night-mode .modal-title {
  color: #f5f5f7;
}

.modal-content.night-mode .profile-tip,
.modal-content.night-mode .favorite-description,
.modal-content.night-mode .settings-subtitle {
  color: #d1d1d6;
}

.modal-content.night-mode .modal-favorite-item {
  background: rgba(58, 58, 60, 0.8);
  color: #f5f5f7;
}

.modal-content.night-mode .settings-item {
  background: rgba(58, 58, 60, 0.8);
}

.modal-content.night-mode .model-option {
  color: #f5f5f7;
}

.my-container.night-mode .profile-inline-btn {
  background: rgba(255, 255, 255, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.my-container.night-mode .profile-inline-btn.outline {
  border-color: rgba(255, 255, 255, 0.3);
}

.my-container.night-mode .favorite-star {
  color: #ffd60a;
}
