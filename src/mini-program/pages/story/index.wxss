.story-page {
  position: relative;
  min-height: 100vh;
  background: #ffffff;
  overflow: hidden;
}


.panel-swiper {
  height: 100vh;
}

.panel-scroll {
  height: 100vh;
  box-sizing: border-box;
}


.story-panel {
  width: 100%;
  min-height: 100vh;
  background: #ffffff;
  position: relative;
}

.panel-inner {
  position: relative;
  padding: 32rpx;
  padding-top: calc(env(safe-area-inset-top, 0) + 100rpx);
  padding-bottom: calc(env(safe-area-inset-bottom, 0) + 320rpx);
  box-sizing: border-box;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.top-controls {
  position: absolute;
  top: calc(env(safe-area-inset-top, 0) + 24rpx);
  left: 32rpx;
  right: 32rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  pointer-events: none;
  z-index: 10;
}

.turn-badge {
  background: rgba(142, 142, 147, 0.16);
  color: #1c1c1e;
  font-size: 24rpx;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  pointer-events: auto;
  margin-right: auto;
}

.top-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  pointer-events: auto;
  gap: 16rpx;
}

.refresh-button {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(142, 142, 147, 0.2);
  background: rgba(142, 142, 147, 0.12);
  color: #0a84ff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.story-content {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  flex: 1;
  padding-bottom: 260rpx;
}

.story-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #0a0a0a;
  line-height: 56rpx;
}

.narrative {
  display: block;
  font-size: 32rpx;
  line-height: 48rpx;
  color: #141414;
  white-space: pre-wrap;
}

.moderation {
  padding: 24rpx;
  border-radius: 16rpx;
  background: rgba(255, 69, 58, 0.14);
  color: #ff3b30;
  font-size: 28rpx;
}

.panel-error {
  padding: 20rpx;
  border-radius: 12rpx;
  background: rgba(255, 149, 0, 0.12);
  color: #ff9500;
  font-size: 26rpx;
}

.panel-actions {
  position: absolute;
  left: 0;
  right: 0;
  bottom: calc(env(safe-area-inset-bottom, 0) + 112rpx);
  padding: 20rpx 32rpx calc(env(safe-area-inset-bottom, 0) + 20rpx);
  box-sizing: border-box;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0) 0%, #ffffff 65%);
  box-shadow: 0 -16rpx 32rpx rgba(0, 0, 0, 0.12);
  z-index: 15;
}

.panel-actions-options {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  grid-auto-rows: 1fr;
  gap: 20rpx;
  padding: 12rpx;
}

.option-button {
  width: 100%;
  height: 100%;
  font-size: 40rpx;
  min-height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: linear-gradient(90deg, #0a84ff 0%, #007aff 100%);
  color: #ffffff;
  box-shadow: 0 12rpx 24rpx rgba(10, 132, 255, 0.25);
}

.option-button:disabled {
  opacity: 0.72;
}

.panel-actions-ending {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  align-items: stretch;
  padding: 12rpx;
}

.ending-message {
  font-size: 30rpx;
  color: #1c1c1e;
  text-align: center;
}

.secondary {
  background: rgba(142, 142, 147, 0.16);
  color: #1c1c1e;
  border-radius: 12rpx;
  padding: 24rpx;
}

.theme-switcher {
  position: fixed;
  top: 50%;
  right: 32rpx;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  z-index: 20;
}

.theme-button {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(28, 28, 30, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 24rpx rgba(0, 0, 0, 0.18);
  color: #ffffff;
  backdrop-filter: blur(8rpx);
}

.theme-button-disabled {
  background: rgba(142, 142, 147, 0.4);
  color: rgba(255, 255, 255, 0.72);
}

.theme-icon {
  font-size: 42rpx;
  line-height: 1;
}

.favorite-button {
  background: rgba(142, 142, 147, 0.4);
  color: #ffffff;
}

.favorite-button .theme-icon {
  font-size: 36rpx;
}

.favorite-active {
  background: linear-gradient(135deg, #ffd60a 0%, #ff9f0a 100%);
  color: #1c1c1e;
}

.favorite-disabled {
  opacity: 0.5;
  pointer-events: none;
}

.loading-placeholder {
  width: 44rpx;
  height: 44rpx;
}

.global-loading {
  position: fixed;
  top: calc(env(safe-area-inset-top, 0) + 16rpx);
  right: 32rpx;
  z-index: 40;
  display: flex;
  justify-content: flex-end;
  pointer-events: none;
}

.global-loading-inner {
  pointer-events: none;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 12rpx 28rpx rgba(0, 0, 0, 0.12);
  backdrop-filter: blur(24rpx);
}

.global-loading-inner .ai-loading {
  pointer-events: none;
}

.global-loading-inner.night-mode {
  background: rgba(44, 44, 46, 0.88);
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.45);
}

.story-page.night-mode {
  background: #1c1c1e;
  color: #f2f2f7;
}

.story-page.night-mode .story-panel {
  background: #1c1c1e;
}

.story-page.night-mode .panel-inner {
  color: #f2f2f7;
}

.story-page.night-mode .story-content {
  color: #e5e5ea;
}

.story-page.night-mode .story-title {
  color: #f2f2f7;
}

.story-page.night-mode .narrative {
  color: #f5f5f7;
}

.story-page.night-mode .moderation {
  background: rgba(255, 69, 58, 0.24);
  color: #ff9f0a;
}

.story-page.night-mode .panel-error {
  background: rgba(255, 159, 10, 0.28);
  color: #ffd60a;
}

.story-page.night-mode .panel-actions {
  background: linear-gradient(180deg, rgba(28, 28, 30, 0) 0%, rgba(28, 28, 30, 0.94) 70%);
  box-shadow: 0 -16rpx 40rpx rgba(0, 0, 0, 0.5);
}

.story-page.night-mode .secondary {
  background: rgba(99, 99, 102, 0.32);
  color: #f2f2f7;
}

.story-page.night-mode .turn-badge {
  background: rgba(99, 99, 102, 0.32);
  color: #f2f2f7;
}

.story-page.night-mode .refresh-button {
  border-color: rgba(142, 142, 147, 0.4);
  background: rgba(58, 58, 60, 0.6);
  color: #66aaff;
}

.story-page.night-mode .theme-switcher {
  filter: drop-shadow(0 12rpx 24rpx rgba(0, 0, 0, 0.6));
}

.story-page.night-mode .theme-button {
  background: rgba(58, 58, 60, 0.92);
  color: #f2f2f7;
}

.story-page.night-mode .theme-button-disabled {
  background: rgba(99, 99, 102, 0.5);
  color: rgba(235, 235, 245, 0.5);
}

.story-page.night-mode .favorite-button {
  background: rgba(99, 99, 102, 0.6);
  color: #f5f5f7;
}

.story-page.night-mode .favorite-active {
  background: linear-gradient(135deg, #ffd60a 0%, #ffac33 100%);
  color: #1c1c1e;
}
