<view class="tab-bar {{nightMode ? 'night-mode' : ''}}">
  <view
    wx:for="{{tabs}}"
    wx:key="pagePath"
    class="tab-item {{selected === index ? 'active' : ''}}"
    data-index="{{index}}"
    data-path="{{item.pagePath}}"
    bindtap="onTap"
  >
    <text class="tab-text">{{item.text}}</text>
  </view>
</view>
