[2m2025-10-13T08:27:22.922840Z[0m [32m INFO[0m FunctionCall: shell({"command":["bash","-lc","apply_patch <<'PATCH'\n*** Begin Patch\n*** Update File: backend/src/services/deepseekProxy.ts\n@@\n-export const invokeDeepSeek = async (messages: DeepSeekMessage[]): Promise<DeepSeekResponse> => {\n-  const config = loadConfig();\n-\n-  if (config.deepseek.mock) {\n-    return {\n-      choices: [\n-        {\n-          message: {\n-            role: 'assistant',\n-            content: '故事继续：\\n1. 继续追踪线索\\n2. 与同伴讨论\\n3. 查询线索\\n4. 结束调查'\n-          }\n-        }\n-      ]\n-    };\n-  }\n-\n-  const response = await fetch(`${config.deepseek.baseUrl}/chat/completions`, {\n-    method: 'POST',\n-    headers: {\n-      'content-type': 'application/json',\n-      authorization: `Bearer ${config.deepseek.apiKey}`\n-    },\n-    body: JSON.stringify({\n-      model: config.deepseek.model,\n-      messages\n-    })\n-  });\n-\n-  if (!response.ok) {\n-    throw new Error(`DeepSeek call failed: ${response.status}`);\n-  }\n-\n-  const json = (await response.json()) as DeepSeekResponse;\n-  return json;\n-};\n+export const invokeDeepSeek = async (messages: DeepSeekMessage[]): Promise<DeepSeekResponse> => {\n+  const config = loadConfig();\n+\n+  if (config.deepseek.mock) {\n+    return {\n+      choices: [\n+        {\n+          message: {\n+            role: 'assistant',\n+            content: '故事继续：\\n1. 继续追踪线索\\n2. 与同伴讨论\\n3. 查询线索\\n4. 结束调查'\n+          }\n+        }\n+      ]\n+    };\n+  }\n+\n+  const retries = Math.max(0, config.deepseek.maxRetries);\n+  const timeoutMs = Math.max(1000, config.deepseek.timeoutMs);\n+\n+  for (let attempt = 0; attempt <= retries; attempt++) {\n+    const controller = new AbortController();\n+    const timeoutId = setTimeout(() => controller.abort(), timeoutMs);\n+\n+    try {\n+      const response = await fetch(`${config.deepseek.baseUrl}/chat/completions`, {\n+        method: 'POST',\n+        headers: {\n+          'content-type': 'application/json',\n+          authorization: `Bearer ${config.deepseek.apiKey}`\n+        },\n+        body: JSON.stringify({\n+          model: config.deepseek.model,\n+          messages\n+        }),\n+        signal: controller.signal\n+      });\n+\n+      clearTimeout(timeoutId);\n+\n+      if (!response.ok) {\n+        throw new Error(`DeepSeek call failed: ${response.status}`);\n+      }\n+\n+      const json = (await response.json()) as DeepSeekResponse;\n+      return json;\n+    } catch (error) {\n+      clearTimeout(timeoutId);\n+      const isAbortError = error instanceof Error && error.name === 'AbortError';\n+\n+      if (attempt < retries) {\n+        if (isAbortError) {\n+          // brief backoff before retrying when the upstream times out\n+          await new Promise((resolve) => setTimeout(resolve, 200 * (attempt + 1)));\n+        }\n+        continue;\n+      }\n+\n+      if (isAbortError) {\n+        throw new Error(`DeepSeek call timed out after ${timeoutMs}ms`);\n+      }\n+\n+      throw error instanceof Error ? error : new Error('DeepSeek call failed');\n+    }\n+  }\n+\n+  // Should be unreachable, loop either returns or throws.\n+  throw new Error('DeepSeek call failed');\n+};\n@@\n-export const generateTurn = async (options: StoryTurnOptions): Promise<StoryTurnResult> => {\n-  const { sessionId, themeId, themePrompt, history, selectedOption } = options;\n-  const start = Date.now();\n-\n-  const promptMessages = buildPrompt(themePrompt, history, selectedOption);\n-  const response = await invokeDeepSeek(promptMessages);\n-  const { content } = response.choices[0].message;\n-\n-  const narrative = sanitizeResponse(content);\n-  const optionsList = parseOptions(content);\n-  const ending = isEndingFlag(optionsList);\n-\n-  const latencyMs = Date.now() - start;\n-  const telemetryOutcome: StoryTurnResult['telemetryOutcome'] = ending ? 'success' : 'success';\n-\n-  const telemetryClient = getTelemetryClient();\n-  const telemetryPayload = {\n-    sessionIdHash: hashSession(sessionId),\n-    themeId,\n-    turnIndex: history.length,\n-    latencyMs,\n-    outcome: telemetryOutcome,\n-    timestamp: new Date().toISOString()\n-  };\n-\n-  await telemetryClient.recordTurn(telemetryPayload);\n-\n-  if (ending) {\n-    return { narrative, options: [], ending: true, latencyMs, telemetryOutcome };\n-  }\n-\n-  if (optionsList.length < 4) {\n-    return {\n-      narrative,\n-      options: [],\n-      ending: true,\n-      moderationMessage: '生成内容缺少选项，已结束会话',\n-      latencyMs,\n-      telemetryOutcome: 'handled_error'\n-    };\n-  }\n-\n-  return {\n-    narrative,\n-    options: optionsList,\n-    ending: false,\n-    latencyMs,\n-    telemetryOutcome\n-  };\n-};\n+export const generateTurn = async (options: StoryTurnOptions): Promise<StoryTurnResult> => {\n+  const { sessionId, themeId, themePrompt, history, selectedOption } = options;\n+  const start = Date.now();\n+  const telemetryClient = getTelemetryClient();\n+  const sessionIdHash = hashSession(sessionId);\n+\n+  try {\n+    const promptMessages = buildPrompt(themePrompt, history, selectedOption);\n+    const response = await invokeDeepSeek(promptMessages);\n+    const content = response.choices[0]?.message?.content;\n+\n+    if (!content) {\n+      throw new Error('DeepSeek response missing content');\n+    }\n+\n+    const narrative = sanitizeResponse(content);\n+    const optionsList = parseOptions(content);\n+    const ending = isEndingFlag(optionsList);\n+\n+    let telemetryOutcome: StoryTurnResult['telemetryOutcome'] = 'success';\n+    const latencyMs = Date.now() - start;\n+\n+    const baseResult = {\n+      narrative,\n+      latencyMs\n+    } as const;\n+\n+    if (ending) {\n+      await telemetryClient.recordTurn({\n+        sessionIdHash,\n+        themeId,\n+        turnIndex: history.length,\n+        latencyMs,\n+        outcome: telemetryOutcome,\n+        timestamp: new Date().toISOString()\n+      });\n+\n+      return {\n+        ...baseResult,\n+        options: [],\n+        ending: true,\n+        telemetryOutcome\n+      };\n+    }\n+\n+    if (optionsList.length < 4) {\n+      telemetryOutcome = 'handled_error';\n+\n+      await telemetryClient.recordTurn({\n+        sessionIdHash,\n+        themeId,\n+        turnIndex: history.length,\n+        latencyMs,\n+        outcome: telemetryOutcome,\n+        timestamp: new Date().toISOString()\n+      });\n+\n+      return {\n+        ...baseResult,\n+        options: [],\n+        ending: true,\n+        moderationMessage: '生成内容缺少选项，已结束会话',\n+        telemetryOutcome\n+      };\n+    }\n+\n+    await telemetryClient.recordTurn({\n+      sessionIdHash,\n+      themeId,\n+      turnIndex: history.length,\n+      latencyMs,\n+      outcome: telemetryOutcome,\n+      timestamp: new Date().toISOString()\n+    });\n+\n+    return {\n+      ...baseResult,\n+      options: optionsList,\n+      ending: false,\n+      telemetryOutcome\n+    };\n+  } catch (error) {\n+    const latencyMs = Date.now() - start;\n+    const telemetryOutcome: StoryTurnResult['telemetryOutcome'] = 'handled_error';\n+\n+    await telemetryClient.recordTurn({\n+      sessionIdHash,\n+      themeId,\n+      turnIndex: history.length,\n+      latencyMs,\n+      outcome: telemetryOutcome,\n+      timestamp: new Date().toISOString()\n+    });\n+\n+    return {\n+      narrative: '故事生成服务暂时繁忙，请稍后再试。',\n+      options: [],\n+      ending: true,\n+      moderationMessage:\n+        error instanceof Error ? `生成超时或失败：${error.message}` : '生成超时或失败，已结束会话。',\n+      latencyMs,\n+      telemetryOutcome\n+    };\n+  }\n+};\n*** End Patch\nPATCH\n"],"workdir":"/Users/xinge/Desktop/project/Try_4th"})
