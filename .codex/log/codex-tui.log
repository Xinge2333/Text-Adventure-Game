[2m2025-10-12T19:37:29.900667Z[0m [32m INFO[0m FunctionCall: shell({"command":["bash","-lc","cat <<'EOF' > src/mini-program/pages/story/__tests__/story-loop.test.js\njest.mock('../../utils/api', () => ({\n  api: {\n    startStory: jest.fn(),\n    advanceStory: jest.fn()\n  }\n}));\n\njest.mock('../../utils/telemetry', () => ({\n  submitTurnTelemetry: jest.fn()\n}));\n\nconst flushPromises = () => new Promise((resolve) => setImmediate(resolve));\n\nconst instantiatePage = (config) => {\n  const instance = {\n    data: JSON.parse(JSON.stringify(config.data)),\n    setData(update) {\n      Object.assign(this.data, update);\n    }\n  };\n  Object.entries(config)\n    .filter(([key]) => key !== 'data')\n    .forEach(([key, value]) => {\n      if (typeof value === 'function') {\n        instance[key] = value.bind(instance);\n      } else {\n        instance[key] = value;\n      }\n    });\n  return instance;\n};\n\ndescribe('Story page interactions', () => {\n  let pageConfig;\n  let api;\n  let submitTurnTelemetry;\n\n  const loadPage = () => {\n    jest.isolateModules(() => {\n      require('../../utils/api');\n      require('../../utils/telemetry');\n      require('../index.js');\n    });\n  };\n\n  beforeEach(() => {\n    jest.resetModules();\n    jest.clearAllMocks();\n    pageConfig = null;\n\n    global.wx.showToast.mockClear();\n    global.wx.switchTab.mockClear();\n\n    global.Page = (config) => {\n      pageConfig = config;\n    };\n\n    loadPage();\n    api = require('../../utils/api').api;\n    submitTurnTelemetry = require('../../utils/telemetry').submitTurnTelemetry;\n  });\n\n  afterEach(() => {\n    delete global.Page;\n  });\n\n  it('initializes story session and progresses turns', async () => {\n    api.startStory.mockResolvedValue({\n      sessionId: 'session-1',\n      narrative: '序章',\n      options: ['A', 'B', 'C', 'D'],\n      ending: false,\n      latencyMs: 120,\n      outcome: 'success'\n    });\n\n    api.advanceStory.mockResolvedValue({\n      sessionId: 'session-1',\n      turnIndex: 1,\n      narrative: '第二段',\n      options: ['A1', 'B1', 'C1', 'D1'],\n      ending: false,\n      moderationMessage: '',\n      latencyMs: 150,\n      outcome: 'success'\n    });\n\n    const page = instantiatePage(pageConfig);\n\n    await page.onLoad({ themeId: 'school-revenge' });\n    await flushPromises();\n\n    expect(api.startStory).toHaveBeenCalledWith('school-revenge');\n    expect(page.data.sessionId).toBe('session-1');\n    expect(page.data.narrative).toBe('序章');\n    expect(page.data.options).toHaveLength(4);\n\n    await page.onSelectOption({ currentTarget: { dataset: { index: 1 } } });\n    await flushPromises();\n\n    expect(api.advanceStory).toHaveBeenCalledWith('session-1', 2);\n    expect(page.data.narrative).toBe('第二段');\n    expect(page.data.options[0]).toBe('A1');\n    expect(submitTurnTelemetry).toHaveBeenCalledWith(\n      expect.objectContaining({\n        sessionIdHash: 'session-1',\n        themeId: 'school-revenge',\n        turnIndex: 1,\n        outcome: 'success'\n      })\n    );\n  });\n\n  it('handles ending state and shows toast on error', async () => {\n    api.startStory.mockResolvedValue({\n      sessionId: 'session-1',\n      narrative: '终章',\n      options: [],\n      ending: true,\n      latencyMs: 80,\n      outcome: 'success'\n    });\n\n    api.advanceStory.mockRejectedValue(new Error('network error'));\n\n    const page = instantiatePage(pageConfig);\n    await page.onLoad({ themeId: 'school-revenge' });\n    await flushPromises();\n\n    expect(page.data.ending).toBe(true);\n\n    await page.onSelectOption({ currentTarget: { dataset: { index: 0 } } });\n    await flushPromises();\n\n    expect(api.advanceStory).not.toHaveBeenCalled();\n\n    page.setData({ sessionId: 'session-1', ending: false });\n    await page.advanceStory(1);\n    expect(global.wx.showToast).toHaveBeenCalledWith({ title: '加载失败，请重试', icon: 'none' });\n  });\n});\nEOF\n"],"workdir":"/Users/xinge/Desktop/project/Try_4th"})
