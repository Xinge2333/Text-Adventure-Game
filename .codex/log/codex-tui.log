lass=\"modal-mask\" bindtap=\"closeModals\">\n+  <view class=\"modal-content\" catchtap=\"noop\">\n+    <view class=\"modal-title\">设置</view>\n+    <view class=\"modal-body\">\n+      <view class=\"settings-item\">\n+        <view class=\"settings-text\">\n+          <view class=\"settings-title\">夜间模式</view>\n+          <view class=\"settings-subtitle\">开启后使用深色界面</view>\n+        </view>\n+        <switch checked=\"{{nightMode}}\" bindchange=\"onNightModeChange\" />\n+      </view>\n+\n+      <view class=\"settings-item column\">\n+        <view class=\"settings-text\">\n+          <view class=\"settings-title\">切换 AI 模型</view>\n+          <view class=\"settings-subtitle\">当前：{{selectedModel === 'qwen' ? 'Qwen' : 'DeepSeek'}}</view>\n+        </view>\n+        <radio-group class=\"model-options\" bindchange=\"onModelChange\">\n+          <label class=\"model-option\" wx:for=\"{{modelOptions}}\" wx:key=\"id\">\n+            <radio value=\"{{item.id}}\" checked=\"{{item.id === selectedModel}}\" />\n+            <text>{{item.label}}</text>\n+          </label>\n+        </radio-group>\n+      </view>\n+    </view>\n+    <button class=\"modal-close\" bindtap=\"closeModals\">完成</button>\n+  </view>\n+</view>\n*** End Patch\nPATCH\n"]})
