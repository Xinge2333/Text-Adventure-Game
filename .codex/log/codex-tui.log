set(key, current + value * (stats.plays * PLAY_WEIGHT + stats.optionClicks * OPTION_WEIGHT));\n    });\n  });\n\n  return profile;\n};\nEOF"],"workdir":"/Users/xinge/Desktop/project/Try_4th"})
[2m2025-10-25T21:28:43.113155Z[0m [32m INFO[0m FunctionCall: shell({"command":["bash","-lc","cat <<'EOF' > backend/src/services/recommendations.ts\nimport { getCatalogIndex, type ThemeMetadata } from './themeIndex';\nimport { behaviorStore } from '../storage/behaviorStore';\nimport { userStore } from '../storage/userStore';\n\ninterface ThemeScore {\n  theme: ThemeMetadata;\n  score: number;\n  reason: string;\n}\n\ninterface TagVector {\n  [tag: string]: number;\n}\n\nconst FAVORITE_WEIGHT = 3;\nconst PLAY_WEIGHT = 1;\nconst OPTION_WEIGHT = 0.5;\nconst POPULARITY_WEIGHT = 0.15;\nconst FRESH_WEIGHT = 0.2;\nconst FRESH_HALF_LIFE_DAYS = 14;\n\nconst toLowerTags = (tags: string[]) => tags.map((tag) => tag.toLowerCase());\n\nconst addToVector = (vector: Map<string, number>, tags: string[], weight: number) => {\n  tags.forEach((tag) => {\n    const key = tag.toLowerCase();\n    vector.set(key, (vector.get(key) ?? 0) + weight);\n  });\n};\n\nconst buildUserProfile = async (userId: string, favorites: ThemeMetadata[]): Promise<Map<string, number>> => {\n  const profile = new Map<string, number>();\n  favorites.forEach((theme) => addToVector(profile, theme.tags, FAVORITE_WEIGHT));\n\n  const history = await behaviorStore.getUserHistory(userId);\n  Object.entries(history).forEach(([themeId, stats]) => {\n    const themeTags = cachedThemeTags.get(themeId);\n    if (themeTags) {\n      const weight = stats.plays * PLAY_WEIGHT + stats.optionClicks * OPTION_WEIGHT;\n      addToVector(profile, themeTags, weight);\n    }\n  });\n\n  return profile;\n};\n\nconst cachedThemeTags = new Map<string, string[]>();\n\nconst getThemeTags = (theme: ThemeMetadata): string[] => {\n  const cached = cachedThemeTags.get(theme.themeId);\n  if (cached) return cached;\n  const tags = toLowerTags(theme.tags);\n  cachedThemeTags.set(theme.themeId, tags);\n  return tags;\n};\n\nconst cosineSimilarity = (profile: Map<string, number>, themeTags: string[]): number => {\n  if (profile.size === 0 || themeTags.length === 0) {\n    return 0;\n  }\n  let dot = 0;\n  let themeMag = 0;\n  let profileMag = 0;\n\n  themeTags.forEach((tag) => {\n    const themeWeight = 1;\n    themeMag += themeWeight * themeWeight;\n    const profileWeight = profile.get(tag) ?? 0;\n    if (profileWeight) {\n      dot += themeWeight * profileWeight;\n    }\n  });\n\n  profile.forEach((value) => {\n    profileMag += value * value;\n  });\n\n  if (profileMag === 0 || themeMag === 0) {\n    return 0;\n  }\n  return dot / (Math.sqrt(themeMag) * Math.sqrt(profileMag));\n};\n\nconst computeFreshness = (lastUpdated: string): number => {\n  const updatedAt = new Date(lastUpdated).getTime();\n  if (Number.isNaN(updatedAt)) {\n    return 0;\n  }\n  const ageDays = (Date.now() - updatedAt) / (1000 * 60 * 60 * 24);\n  const halfLife = FRESH_HALF_LIFE_DAYS;\n  return Math.exp(-ageDays / halfLife);\n};\n\nconst rankThemes = async (userId: string, limit: number): Promise<ThemeScore[]> => {\n  const index = await getCatalogIndex();\n  const themeStats = await behaviorStore.getAllThemeStats();\n  const userRecord = await userStore.getBySessionToken(userId);\n  void userRecord;\n\n  const userFavoritesRecord = await userStore.getBySessionToken(userId);\n  void userFavoritesRecord;\n\n  const userFavorites = await userStore.getBySessionToken(userId);\n  void userFavorites;\n\n  const favorites = await (async () => {\n    const user = await userStore.getBySessionToken(userId);\n    return user?.favorites ?? [];\n  })();\n\n  const favoriteThemes = favorites\n    .map((fav) => index.themes.find((theme) => theme.themeId === fav.themeId))\n    .filter((theme): theme is ThemeMetadata => Boolean(theme));\n\n  const profile = await buildUserProfile(userId, favoriteThemes);\n\n  const scored: ThemeScore[] = index.themes.map((theme) => {\n    const tags = getThemeTags(theme);\n    const similarity = cosineSimilarity(profile, tags);\n    const stats = themeStats[theme.themeId] ?? { plays: 0, favorites: 0, optionClicks: 0 };\n    const popularity = stats.plays + stats.favorites * 2 + stats.optionClicks * 0.5;\n    const fresh = computeFreshness(theme.lastUpdated);\n    const finalScore = similarity + POPULARITY_WEIGHT * popularity + FRESH_WEIGHT * fresh;\n    const reason = similarity > 0.1 ? `因为你常玩 ${tags[0] || '该类型'}` : fresh > 0.5 ? '新鲜上线' : '热门推荐';\n    return { theme, score: finalScore, reason };\n  });\n\n  scored.sort((a, b) => b.score - a.score);\n\n  const picked: ThemeScore[] = [];\n  const seenPrimaryTags = new Set<string>();\n\n  for (const candidate of scored) {\n    if (picked.length >= limit) break;\n    const primaryTag = candidate.theme.tags[0]?.toLowerCase() ?? candidate.theme.themeId;\n    if (!seenPrimaryTags.has(primaryTag) || picked.length >= 3) {\n      picked.push(candidate);\n      seenPrimaryTags.add(primaryTag);\n    }\n  }\n\n  if (picked.length < limit) {\n    for (const candidate of scored) {\n      if (picked.length >= limit) break;\n      if (!picked.find((item) => item.theme.themeId === candidate.theme.themeId)) {\n        picked.push(candidate);\n      }\n    }\n  }\n\n  return picked.slice(0, limit);\n};\n\nexport const getRecommendations = async (userId: string, limit = 5) => {\n  return rankThemes(userId, limit);\n};\nEOF"],"workdir":"/Users/xinge/Desktop/project/Try_4th"})
