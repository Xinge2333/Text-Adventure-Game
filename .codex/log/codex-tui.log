= 'qwen' ? 'Qwen' : 'DeepSeek'}}</view>\n        </view>\n        <radio-group class=\"model-options\" bindchange=\"onModelChange\">\n          <label class=\"model-option\" wx:for=\"{{modelOptions}}\" wx:key=\"id\">\n            <radio value=\"{{item.id}}\" checked=\"{{item.id === selectedModel}}\" />\n            <text>{{item.label}}</text>\n          </label>\n        </radio-group>\n      </view>\n    </view>\n    <button class=\"modal-close\" bindtap=\"closeModals\">完成</button>\n  </view>\n</view>\nEOF\n"],"workdir":"/Users/xinge/Desktop/project/Try_4th"})
