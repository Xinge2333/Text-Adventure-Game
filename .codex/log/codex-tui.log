[2m2025-10-12T18:43:12.108699Z[0m [32m INFO[0m FunctionCall: shell({"command":["bash","-lc","cat <<'EOF' > backend/src/routes/stories.ts\nimport { FastifyInstance } from 'fastify';\nimport { getCatalogIndex } from '../services/themeIndex';\nimport { generateTurn, buildPrompt } from '../services/deepseekProxy';\n\ninterface SessionState {\n  themeId: string;\n  themePrompt: string;\n  history: { role: 'system' | 'user' | 'assistant'; content: string }[];\n}\n\nconst sessions = new Map<string, SessionState>();\n\nconst createSession = (themeId: string, themePrompt: string): string => {\n  const sessionId = crypto.randomUUID();\n  sessions.set(sessionId, {\n    themeId,\n    themePrompt,\n    history: []\n  });\n  return sessionId;\n};\n\nconst crypto = require('node:crypto');\n\nexport const storiesRoutes = async (app: FastifyInstance) => {\n  app.post('/stories', async (request, reply) => {\n    const { themeId } = request.body as { themeId: string };\n\n    if (!themeId) {\n      return reply.status(400).send({ message: 'themeId required' });\n    }\n\n    const index = await getCatalogIndex();\n    const theme = index.themes.find((t) => t.themeId === themeId);\n\n    if (!theme) {\n      return reply.status(400).send({ message: 'Theme not found' });\n    }\n\n    const sessionId = createSession(themeId, theme.title);\n\n    const turn = await generateTurn({\n      sessionId,\n      themeId,\n      themePrompt: theme.title,\n      history: []\n    });\n\n    sessions.get(sessionId)?.history.push({ role: 'assistant', content: turn.narrative });\n\n    return {\n      sessionId,\n      turnIndex: 0,\n      narrative: turn.narrative,\n      options: turn.options,\n      ending: turn.ending\n    };\n  });\n\n  app.post('/stories/:sessionId/turns', async (request, reply) => {\n    const { sessionId } = request.params as { sessionId: string };\n    const { selectedOption } = request.body as { selectedOption: number };\n\n    const session = sessions.get(sessionId);\n    if (!session) {\n      return reply.status(400).send({ message: 'Session expired or invalid' });\n    }\n\n    if (!selectedOption || selectedOption < 1 || selectedOption > 4) {\n      return reply.status(400).send({ message: 'selectedOption must be between 1 and 4' });\n    }\n\n    session.history.push({ role: 'user', content: `玩家选择了选项 ${selectedOption}` });\n\n    const turn = await generateTurn({\n      sessionId,\n      themeId: session.themeId,\n      themePrompt: session.themePrompt,\n      history: session.history,\n      selectedOption\n    });\n\n    session.history.push({ role: 'assistant', content: turn.narrative });\n\n    if (turn.ending) {\n      sessions.delete(sessionId);\n    }\n\n    return {\n      sessionId,\n      turnIndex: session.history.length,\n      narrative: turn.narrative,\n      options: turn.options,\n      ending: turn.ending,\n      moderationMessage: turn.moderationMessage\n    };\n  });\n};\nEOF\n"],"workdir":"/Users/xinge/Desktop/project/Try_4th"})
