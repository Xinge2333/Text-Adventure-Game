[2m2025-10-13T19:16:19.993884Z[0m [32m INFO[0m FunctionCall: shell({"command":["bash","-lc","cat <<'EOF' > src/mini-program/pages/story/index.js\nimport { api } from '../../utils/api';\nimport { submitTurnTelemetry } from '../../utils/telemetry';\n\nPage({\n  currentModelProvider: 'qwen',\n  data: {\n    themeId: '',\n    sessionId: '',\n    narrative: '',\n    options: [],\n    ending: false,\n    moderationMessage: '',\n    isLoading: false,\n    turnCount: 0\n  },\n\n  onLoad(query) {\n    const { themeId } = query;\n    if (themeId) {\n      this.setData({ themeId });\n      void this.startStory(themeId);\n      const app = getApp();\n      if (app && app.globalData) {\n        app.globalData.pendingThemeId = '';\n      }\n    }\n  },\n\n  onShow() {\n    const app = getApp();\n    const pending = app?.globalData?.pendingThemeId;\n    if (pending && pending !== this.data.themeId) {\n      this.setData({ themeId: pending });\n      app.globalData.pendingThemeId = '';\n      void this.startStory(pending);\n    }\n  },\n\n  async startStory(themeId) {\n    this.setData({ isLoading: true, moderationMessage: '', turnCount: 0 });\n    try {\n      const app = getApp();\n      const modelProvider = app?.globalData?.preferredModel || this.currentModelProvider || 'qwen';\n      this.currentModelProvider = modelProvider;\n      const response = await api.startStory({ themeId, modelProvider });\n      this.setData({\n        sessionId: response.sessionId,\n        narrative: response.narrative,\n        options: response.options ?? [],\n        ending: response.ending ?? false,\n        isLoading: false,\n        turnCount: typeof response.turnIndex === 'number' ? response.turnIndex + 1 : 1\n      });\n    } catch (error) {\n      this.handleError(error);\n    }\n  },\n\n  async onSelectOption(event) {\n    const { index } = event.currentTarget.dataset;\n    const selectedOption = Number(index) + 1;\n    await this.advanceStory(selectedOption);\n  },\n\n  async advanceStory(selectedOption) {\n    if (this.data.ending || !this.data.sessionId) {\n      return;\n    }\n\n    this.setData({ isLoading: true, moderationMessage: '' });\n    try {\n      const modelProvider = this.currentModelProvider || getApp()?.globalData?.preferredModel;\n      const response = await api.advanceStory({\n        sessionId: this.data.sessionId,\n        selectedOption,\n        modelProvider\n      });\n\n      void submitTurnTelemetry({\n        sessionIdHash: this.data.sessionId,\n        themeId: this.data.themeId,\n        turnIndex: response.turnIndex,\n        latencyMs: response.latencyMs ?? 0,\n        outcome: response.outcome || (response.ending ? 'success' : 'success'),\n        timestamp: new Date().toISOString()\n      });\n\n      this.setData({\n        narrative: response.narrative,\n        options: response.options ?? [],\n        ending: response.ending ?? false,\n        moderationMessage: response.moderationMessage ?? '',\n        isLoading: false,\n        turnCount:\n          typeof response.turnIndex === 'number'\n            ? response.turnIndex + 1\n            : this.data.turnCount + 1\n      });\n\n      if (response.ending) {\n        this.setData({ sessionId: '' });\n      }\n    } catch (error) {\n      this.handleError(error);\n    }\n  },\n\n  handleError(error) {\n    console.warn('Story error', error);\n    this.setData({ isLoading: false });\n    wx.showToast({ title: '加载失败，请重试', icon: 'none' });\n  },\n\n  async onRestart() {\n    if (this.data.themeId) {\n      await this.startStory(this.data.themeId);\n    }\n  },\n\n  onRefresh() {\n    if (this.data.isLoading || !this.data.themeId) {\n      return;\n    }\n    void this.startStory(this.data.themeId);\n  },\n\n  onReturnHome() {\n    wx.switchTab({ url: '/pages/catalog/index' });\n  }\n});\nEOF\n"]})
