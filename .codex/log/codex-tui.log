[2m2025-10-12T18:41:55.204391Z[0m [32m INFO[0m FunctionCall: shell({"command":["bash","-lc","cat <<'EOF' > backend/src/services/deepseekProxy.ts\nimport crypto from 'node:crypto';\nimport { config } from '../config';\nimport { getTelemetryClient } from '../telemetry/metrics';\n\ntype DeepSeekRole = 'system' | 'user' | 'assistant';\n\ninterface DeepSeekMessage {\n  role: DeepSeekRole;\n  content: string;\n}\n\ninterface DeepSeekResponseChoice {\n  message: DeepSeekMessage;\n}\n\ninterface DeepSeekResponse {\n  choices: DeepSeekResponseChoice[];\n  usage?: {\n    prompt_tokens: number;\n    completion_tokens: number;\n    total_tokens: number;\n  };\n}\n\nexport interface StoryTurnOptions {\n  sessionId: string;\n  themePrompt: string;\n  history: DeepSeekMessage[];\n  selectedOption?: number;\n}\n\nexport interface StoryTurnResult {\n  narrative: string;\n  options: string[];\n  ending: boolean;\n  moderationMessage?: string;\n}\n\nconst TELEMETRY_CLIENT = getTelemetryClient();\n\nconst isEndingFlag = (options: string[]): boolean => options.length === 0;\n\nconst sanitizeResponse = (text: string): string => text.trim();\n\nconst parseOptions = (text: string): string[] => {\n  const lines = text.split('\\n').map((line) => line.trim()).filter(Boolean);\n  const options: string[] = [];\n\n  for (const line of lines) {\n    const match = line.match(/^\\d+\\.\\s*(.+)$/);\n    if (match) {\n      options.push(match[1]);\n    }\n  }\n\n  return options.slice(0, 4);\n};\n\nexport const invokeDeepSeek = async (messages: DeepSeekMessage[]): Promise<DeepSeekResponse> => {\n  if (!config.deepseek.apiKey) {\n    throw new Error('DeepSeek API key missing');\n  }\n\n  // TODO: Replace with actual HTTP request to DeepSeek proxy API\n  const demoResponse: DeepSeekResponse = {\n    choices: [\n      {\n        message: {\n          role: 'assistant',\n          content: '故事继续：\\n1. 继续追踪线索\\n2. 与同伴讨论\\n3. 查询线索\\n4. 结束调查'\n        }\n      }\n    ]\n  };\n\n  return demoResponse;\n};\n\nexport const buildPrompt = (themePrompt: string, history: DeepSeekMessage[], selectedOption?: number): DeepSeekMessage[] => {\n  const base: DeepSeekMessage[] = [\n    { role: 'system', content: themePrompt }\n  ];\n\n  if (history.length > 0) {\n    base.push(...history);\n  }\n\n  if (selectedOption !== undefined) {\n    base.push({ role: 'user', content: `玩家选择了选项 ${selectedOption}` });\n  }\n\n  return base;\n};\n\nexport const hashSession = (sessionId: string): string => {\n  return crypto.createHash('sha256').update(sessionId).digest('hex');\n};\n\nexport const generateTurn = async (options: StoryTurnOptions): Promise<StoryTurnResult> => {\n  const { sessionId, themePrompt, history, selectedOption } = options;\n  const start = Date.now();\n\n  const promptMessages = buildPrompt(themePrompt, history, selectedOption);\n  const response = await invokeDeepSeek(promptMessages);\n  const { content } = response.choices[0].message;\n\n  const narrative = sanitizeResponse(content);\n  const optionsList = parseOptions(content);\n  const ending = isEndingFlag(optionsList);\n\n  const telemetryPayload = {\n    sessionIdHash: hashSession(sessionId),\n    themeId: options.history[0]?.content ?? 'unknown-theme',\n    turnIndex: history.length,\n    latencyMs: Date.now() - start,\n    outcome: ending ? 'success' : 'success',\n    timestamp: new Date().toISOString()\n  };\n\n  await TELEMETRY_CLIENT.recordTurn(telemetryPayload);\n\n  if (ending) {\n    return { narrative, options: [], ending: true };\n  }\n\n  if (optionsList.length < 4) {\n    return {\n      narrative,\n      options: [],\n      ending: true,\n      moderationMessage: '生成内容缺少选项，已结束会话'\n    };\n  }\n\n  return {\n    narrative,\n    options: optionsList,\n    ending: false\n  };\n};\nEOF\n"],"workdir":"/Users/xinge/Desktop/project/Try_4th"})
