 clientVersion: 'demo-1', favorites: '' },\n      { acceptNotModified: true }\n    );\n    expect(page.data.catalogVersion).toBe('demo-1');\n    expect(global.wx.showToast).not.toHaveBeenCalled();\n  });\n\n  it('updates catalog when new version detected via polling', async () => {\n    const updatedThemes = [\n      {\n        themeId: 'new-theme',\n        title: '新主题',\n        description: '描述',\n        tags: ['test'],\n        isFavorite: false\n      }\n    ];\n\n    api.listThemes\n      .mockResolvedValueOnce({ catalogVersion: 'demo-1', themes: [] })\n      .mockResolvedValueOnce({\n        catalogVersion: 'demo-2',\n        themes: updatedThemes\n      });\n\n    const page = instantiatePage(pageConfig);\n    storage.getFavorites.mockReturnValue([]);\n    page.startPolling = jest.fn();\n\n    await page.initialize();\n    await flushPromises();\n\n    page.startPolling.mockRestore?.();\n    page.startPolling = pageConfig.startPolling.bind(page);\n\n    await page.checkCatalogVersion();\n    expect(api.listThemes).toHaveBeenLastCalledWith(\n      { clientVersion: 'demo-1', favorites: '' },\n      { acceptNotModified: true }\n    );\n    expect(page.data.catalogVersion).toBe('demo-2');\n    expect(page.data.themes).toEqual(updatedThemes);\n    expect(global.wx.showToast).toHaveBeenCalledWith({ title: '已加载新主题', icon: 'success' });\n  });\n});\nEOF\n"],"workdir":"/Users/xinge/Desktop/project/Try_4th"})
